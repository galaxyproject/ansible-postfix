use strict;
{% if postfix_clamav and __postfix_debian %}

# Enable virus checks
@bypass_virus_checks_maps = (
   \%bypass_virus_checks, \@bypass_virus_checks_acl, \$bypass_virus_checks_re);
{% endif %}
{% if postfix_spamassassin and __postfix_debian %}

@bypass_spam_checks_maps = (
   \%bypass_spam_checks, \@bypass_spam_checks_acl, \$bypass_spam_checks_re);
{% endif %}

{% for opt in __postfix_amavisd_new_config_sorted
  if opt in __postfix_amavisd_new_config_merged %}
{% set val = __postfix_amavisd_new_config_merged[opt] %}
{% set val = 'undef' if val is none else
  (val | int) if val is boolean else val %}
{{ opt }} = {{ val }};
{% endfor %}

1;
